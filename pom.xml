<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.github.esrrhs</groupId>
    <artifactId>javalua</artifactId>
    <packaging>jar</packaging>
    <version>1.0.16</version>

    <name>javalua</name>
    <description>Lua 5.4 implemented in pure Java, with the JVM handling garbage collection.</description>
    <url>https://github.com/esrrhs/javalua</url>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!--
          Java 21 是下限:协程跑在虚拟线程上(见 README「关键设计决策」第 4 条)。
          虚拟线程让 yield 可以发生在任意深度的调用栈上,而不必把 lvm.c 的主循环
          改写成显式状态机。代价就是放弃了 Java 8 兼容。
        -->
        <maven.compiler.release>21</maven.compiler.release>
        <junit.jupiter.version>5.10.2</junit.jupiter.version>
        <jazzer.version>0.30.0</jazzer.version>
        <!-- 阶段性门禁值:每完成一个阶段往上抬一档,目标 0.85 -->
        <jacoco.line.minimum>0.95</jacoco.line.minimum>
    </properties>

    <licenses>
        <license>
            <name>The Apache Software License, Version 2.0</name>
            <url>http://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>esrrhs</name>
            <email>esrrhs@163.com</email>
            <url>https://github.com/esrrhs/javalua</url>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:git@github.com:esrrhs/javalua.git</connection>
        <developerConnection>scm:git:git@github.com:esrrhs/javalua.git</developerConnection>
        <url>git@github.com:esrrhs/javalua.git</url>
    </scm>

    <dependencyManagement>
        <dependencies>
            <!--
              锁定 JUnit Platform 版本。jazzer-junit 会传递引入 junit-platform
              1.9.0，与 junit-jupiter 5.10.2 所需的 1.10.2 并存时，engine 与
              commons 版本错配，表现为 "TestEngine with ID 'junit-jupiter'
              failed to discover tests"。统一到 1.10.2 即可。
            -->
            <dependency>
                <groupId>org.junit.platform</groupId>
                <artifactId>junit-platform-commons</artifactId>
                <version>1.10.2</version>
            </dependency>
            <dependency>
                <groupId>org.junit.platform</groupId>
                <artifactId>junit-platform-engine</artifactId>
                <version>1.10.2</version>
            </dependency>
            <dependency>
                <groupId>org.junit.platform</groupId>
                <artifactId>junit-platform-launcher</artifactId>
                <version>1.10.2</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.jupiter.version}</version>
            <scope>test</scope>
        </dependency>
        <!--
          覆盖率引导的模糊测试引擎(基于 libFuzzer,OSS-Fuzz 对 JVM 项目的官方方案)。
          字节码是 Java 8 级别,因此不影响 JDK 8 起编。

          两种运行模式:
          - 默认(不设 JAZZER_FUZZ):只回放 inputs 目录中已保存的输入,当作回归测试,
            行为与普通单元测试一致,不启动 fuzzing 引擎
          - JAZZER_FUZZ=1:启动 libFuzzer 持续变异探索,命中新覆盖或崩溃的输入
            会落盘到 inputs 目录,供后续回归模式重放
        -->
        <dependency>
            <groupId>com.code-intelligence</groupId>
            <artifactId>jazzer-junit</artifactId>
            <version>${jazzer.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.code-intelligence</groupId>
            <artifactId>jazzer-api</artifactId>
            <version>${jazzer.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                    <encoding>${project.build.sourceEncoding}</encoding>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <!--
                      给每一条用例设一个 3 分钟的全局超时。
                      见过一次才知道多必要：一致性闸门曾经<b>卡死 18 分钟</b>
                      （后来证明是基础设施偶发，重跑就好），而 GitHub 只能等到
                      job 超时（默认 6 小时）才给结论 —— 期间<b>日志一行都取不到</b>
                      （gh 要等 job 结束才有日志），于是既不知道是哪条、也不知道
                      卡在哪。设了超时之后它会变成一条 FAILURE，带着线程栈指名
                      是哪条用例。3 分钟对本仓库够了：最慢的 FuzzTest 本机 20 秒。
                    -->
                    <systemPropertyVariables>
                        <junit.jupiter.execution.timeout.default>180s</junit.jupiter.execution.timeout.default>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.12</version>
                <!--
                  覆盖率门禁在新实现落地初期会长期不满足:Lua 5.4 完整实现有
                  几万行,而可用的测试用例要等解释器能跑起来之后才写得出来。
                  所以门禁值(见 jacoco.line.minimum)随阶段推进逐步抬升,
                  而不是一开始就设成 0.85 让它永远红着——永远红的门禁等于
                  没有门禁,反而会掩盖真正的覆盖率下降。
                -->
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>check-coverage</id>
                        <phase>test</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <!-- 随实施阶段推进逐步抬高,目标 0.85;见上方注释 -->
                                            <minimum>${jacoco.line.minimum}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <!--
              没有参考实现时别让覆盖率门禁把构建打红。
              一致性测试（Diff / ConformanceTest / FuzzTest ...）占了行覆盖的
              绝大部分；参考二进制缺席时它们全部 assumeTrue 跳过，覆盖率会掉到
              0.1 左右，门禁必然红——但红的原因不是代码变差了，而是没得比。
              永远红的门禁等于没有门禁，所以这种情况下只跳过 check，
              report 照常生成，覆盖率数字仍然看得见。
              CI 的 conformance job 一定设了 LUA54_BIN，所以那边门禁照旧生效。
            -->
            <id>no-reference-lua</id>
            <activation>
                <property>
                    <name>!env.LUA54_BIN</name>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.jacoco</groupId>
                        <artifactId>jacoco-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>check-coverage</id>
                                <phase>test</phase>
                                <goals>
                                    <goal>check</goal>
                                </goals>
                                <configuration>
                                    <skip>true</skip>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>bench</id>
            <!-- 运行微基准:./mvnw -q -Pbench test-compile exec:java -Dexec.classpathScope=test -->
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.2.0</version>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>quality</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.github.spotbugs</groupId>
                        <artifactId>spotbugs-maven-plugin</artifactId>
                        <version>4.8.6.4</version>
                        <configuration>
                            <failOnError>false</failOnError>
                            <excludeFilterFile>${project.basedir}/spotbugs-exclude.xml</excludeFilterFile>
                        </configuration>
                        <executions>
                            <execution>
                                <id>spotbugs</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>check</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>3.3.0</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>3.6.3</version>
                        <configuration>
                            <doclint>none</doclint>
                        </configuration>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.4</version>
                        <configuration>
                            <gpgArguments>
                                <arg>--pinentry-mode</arg>
                                <arg>loopback</arg>
                            </gpgArguments>
                        </configuration>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.4.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <autoPublish>true</autoPublish>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
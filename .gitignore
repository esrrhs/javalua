target/
*.class
*.jar
*.log

# Jazzer 模糊测试产物：语料库与 crash 复现文件由本地 fuzzing 生成，
# 只有经过确认并落到 JazzerFuzzTestInputs 的输入才应当入库
.cifuzz-corpus/
crash-*

.idea/
*.iml
.project
.classpath
.settings/


# WorkBuddy 工作空间记忆（本地）
.workbuddy/

# 上游 code.lua / luac.lua 跑出来的字节码产物
luac.out

# 测试自己造的临时目录（io/os 的用例要真的在磁盘上建目录、改权限）。
# 以前误入过库里，于是每次跑完测试工作树都是脏的——用例开头那句
# `rm -rf au_tmp` 把受版本控制的文件删了。
au_tmp/

# luashim 的编译产物（native/build.sh 产出，按平台分目录）
# 不入库：换台机器就是另一套二进制，CI 上由上面那个 build 步骤现编。
src/main/resources/native/
